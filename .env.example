# Copy to .env and fill in. (.env is git-ignored — never commit real credentials.)

# Postgres connection string. On Supabase: project -> Connect -> "Transaction pooler" URI
# (port 6543), with [YOUR-PASSWORD] replaced. Any Postgres 13+ works.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-us-west-1.pooler.supabase.com:6543/postgres

# Local dev only — the port to listen on (default 3000).
# PORT=3000

# ---- Text-in (optional) ----
# Twilio -> Console -> Account Info -> Auth Token. When set, /api/sms/inbound only
# accepts requests Twilio signed, so nobody can forge a "manager" text.
TWILIO_AUTH_TOKEN=
# Not using Twilio? Set a secret here instead and have your provider send it as an
# X-Webhook-Secret header (or ?secret=... on the URL).
SMS_WEBHOOK_SECRET=
# Only needed if a proxy rewrites the URL Twilio posts to (signature checks use it).
# TWILIO_WEBHOOK_URL=https://board.example.com/api/sms/inbound
